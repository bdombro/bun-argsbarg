{
  "openapi": "3.1.0",
  "info": {
    "title": "full-example",
    "version": "1.0.0",
    "description": "Argsbarg full example reference app"
  },
  "paths": {
    "/tools/echo": {
      "post": {
        "operationId": "echo",
        "summary": "echo — Echo a message (MCP-friendly leaf).",
        "requestBody": {
          "required": false,
          "content": {
            "application/json; charset=utf-8": {
              "schema": {
                "type": "object",
                "properties": {
                  "message": {
                    "type": "string",
                    "description": "Text to print."
                  }
                },
                "additionalProperties": false,
                "required": [
                  "message"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful tool invocation",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "400": {
            "description": "Invalid arguments or help requested",
            "content": {
              "application/json; charset=utf-8": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    },
                    "exitCode": {
                      "type": "integer"
                    }
                  },
                  "required": [
                    "error"
                  ]
                }
              }
            }
          },
          "404": {
            "description": "Unknown tool",
            "content": {
              "application/json; charset=utf-8": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "error"
                  ]
                }
              }
            }
          },
          "500": {
            "description": "Handler error",
            "content": {
              "application/json; charset=utf-8": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "error"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/tools/status": {
      "post": {
        "operationId": "status",
        "summary": "status — Show resolved config and app version.",
        "requestBody": {
          "required": false,
          "content": {
            "application/json; charset=utf-8": {
              "schema": {
                "type": "object",
                "properties": {
                  "json": {
                    "type": "boolean",
                    "description": "Emit JSON."
                  }
                },
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful tool invocation",
            "content": {
              "application/json": {
                "schema": {
                  "$schema": "http://json-schema.org/draft-07/schema#",
                  "type": "object",
                  "properties": {
                    "defaultRegion": {
                      "type": "string",
                      "description": "Resolved AWS region."
                    },
                    "maxRetries": {
                      "type": "number",
                      "description": "Resolved retry count."
                    },
                    "apiTokenSet": {
                      "type": "boolean",
                      "description": "Whether apiToken is set (value never included)."
                    },
                    "version": {
                      "type": "string",
                      "description": "App version from program root."
                    }
                  },
                  "required": [
                    "apiTokenSet",
                    "version"
                  ],
                  "description": "JSON payload for `full-example status --json`.",
                  "definitions": {}
                }
              }
            }
          },
          "400": {
            "description": "Invalid arguments or help requested",
            "content": {
              "application/json; charset=utf-8": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    },
                    "exitCode": {
                      "type": "integer"
                    }
                  },
                  "required": [
                    "error"
                  ]
                }
              }
            }
          },
          "404": {
            "description": "Unknown tool",
            "content": {
              "application/json; charset=utf-8": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "error"
                  ]
                }
              }
            }
          },
          "500": {
            "description": "Handler error",
            "content": {
              "application/json; charset=utf-8": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "error"
                  ]
                }
              }
            }
          }
        }
      }
    }
  }
}
