# bash (not sh); -e bail on errors, -u error on unset vars, pipefail fails pipelines when any stage fails
set shell := ["bash", "-eu", "-o", "pipefail", "-c"]

export PATH := justfile_directory() + "/node_modules/.bin:" + env_var("PATH")

brew_prefix := `brew --prefix`
tap_parent := brew_prefix + "/Library/Taps/{tapOrg}"
tap_path := tap_parent + "/homebrew-{tapRepo}"

# List available recipes (default)
_:
    @just --list

# Compile the CLI binary to dist/full-example
build:
    bun build ./src/index.ts --compile --outfile=dist/full-example
    @rm -f .*.bun-build

# Run typecheck and format
check: format typecheck

# demo the HTTP API
demo-http:
    #!/usr/bin/env bash
    set -euo pipefail
    bun ./src/index.ts http --port 13000 &
    trap 'kill $! 2>/dev/null || true' EXIT
    until curl -sf http://127.0.0.1:13000/health/liveness >/dev/null; do sleep 0.1; done

# demo a CLI command
demo-cli:
    @just run full-example status

# demo a CLI command
demo-help:
    @just run full-example --help

# Run the CLI from source with optional args; restarts on file changes
dev *ARGS:
    bun --watch ./src/index.ts {{ARGS}}

# Regenerate consumer docs under ./docs/
docgen:
    @just run docs cli-schema --save
    @just run docs cli --save
    @just run docs mcp --save
    @just run docs http --save
    @just run docs openapi --save

alias fmt := format

# Format and lint sources (auto-fix)
format:
    bun run biome check ./src ./scripts --write --unsafe

# Run the HTTP server
http:
    @just run http

# Alias for backward compatibility
install: install-local

# Dev install: build, stage dev formula, brew install, refresh agent artifacts
install-local: uninstall build
    mkdir -p {{tap_parent}}
    ln -sfn '{{justfile_directory()}}' {{tap_path}}
    bun scripts/dev-formula.ts install
    HOMEBREW_NO_ASK=1 brew reinstall --formula bdombro/bun-argsbarg/full-example || HOMEBREW_NO_ASK=1 brew install --force --formula bdombro/bun-argsbarg/full-example
    bun scripts/dev-formula.ts reset
    full-example configure install

# Remove local dev install, then install from GitHub tap (requires gh auth login)
install-production: uninstall
    brew tap bdombro/bun-argsbarg git@github.com:bdombro/bun-argsbarg.git
    brew install full-example
    full-example configure install

# Alias for backward compatibility
reinstall: reinstall-local

# Rebuild binary and swap into Cellar (run install-local first; run `just refresh` for skills/MCP)
reinstall-local: build
    install -m 755 dist/full-example "$(brew --prefix full-example)/bin/full-example"

# Refresh agent skills/MCP without reinstalling the binary
refresh:
    full-example configure install

# Lint sources without writing
lint:
    bun run biome check ./src ./scripts

# Run the CLI from source once
run *ARGS:
    bun ./src/index.ts {{ARGS}}

# Generate JSON Schema artifacts from TypeScript types (not used in this template)
schemagen:
    @echo "No @sg types in the cli template. Use argsbarg create --template json or add /** @sg */ types first."

# Install bun/npm dependencies
setup:
    bun install
    test -f node_modules/argsbarg/bin/argsbarg && ln -sf ../argsbarg/bin/argsbarg node_modules/.bin/argsbarg

# Run unit tests (after check)
test: check
    bun test .

# Bump version, build, publish; or pass --purge to delete stale GitHub releases
release *ARGS:
    bun scripts/release.ts {{ARGS}}

# Install release formula from tap and run formula test
test-release:
    HOMEBREW_NO_ASK=1 brew untap bdombro/bun-argsbarg 2>/dev/null || true
    mkdir -p {{tap_parent}}
    ln -sfn '{{justfile_directory()}}' {{tap_path}}
    HOMEBREW_NO_ASK=1 brew uninstall --formula bdombro/bun-argsbarg/full-example 2>/dev/null || true
    brew install --formula bdombro/bun-argsbarg/full-example
    brew test full-example

# Typecheck without emitting build artifacts
typecheck:
    bun run tsc --noEmit

# Undo dev/Homebrew install (remove agent artifacts, then keg + untap)
uninstall:
    @full-example configure uninstall --yes 2>/dev/null || just run configure uninstall --yes
    @HOMEBREW_NO_ASK=1 brew uninstall --formula bdombro/bun-argsbarg/full-example 2>/dev/null || true
    @HOMEBREW_NO_ASK=1 brew uninstall --formula bdombro/bun-argsbarg/full-example-local 2>/dev/null || true
    @HOMEBREW_NO_ASK=1 brew untap bdombro/bun-argsbarg 2>/dev/null || true
