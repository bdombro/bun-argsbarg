# bash (not sh); -e bail on errors, -u error on unset vars, pipefail fails pipelines when any stage fails
set shell := ["bash", "-eu", "-o", "pipefail", "-c"]

export PATH := justfile_directory() + "/node_modules/.bin:" + env_var("PATH")

# List available recipes (default)
_:
    @just --list

# Format, typecheck, and rebuild the committed Node bundle
check: format typecheck build

# Bundle the Node MCP server that plugins run (commit dist/example-agent-plugin.mjs)
build:
    bun build ./src/index.ts --target=node --minify-whitespace --minify-syntax --outfile=./dist/example-agent-plugin.mjs

# demo the HTTP API
demo-http:
    #!/usr/bin/env bash
    set -euo pipefail
    bun ./src/index.ts http --port 13000 &
    trap 'kill $! 2>/dev/null || true' EXIT
    until curl -sf http://127.0.0.1:13000/health/liveness >/dev/null; do sleep 0.1; done

# demo a CLI command
demo-cli:
    @just run example-agent-plugin status

# demo a CLI command
demo-help:
    @just run example-agent-plugin --help

# Run the CLI from source with optional args; restarts on file changes
dev *ARGS:
    bun --watch ./src/index.ts {{ARGS}}

# Regenerate consumer docs under ./docs/
docgen:
    @just run docs cli-schema --save
    @just run docs cli --save
    @just run docs mcp --save
    @just run docs http --save
    @just run docs openapi --save

alias fmt := format

# Format and lint sources (auto-fix)
format:
    bun run biome check ./src ./scripts --write --unsafe

# Run the HTTP server
http:
    @just run http

# Lint sources without writing
lint:
    bun run biome check ./src ./scripts

# Install the Claude Code plugin from this checkout (restart Claude Code afterwards)
plugin-claude-install: build
    claude plugin marketplace add "$(pwd)"
    claude plugin install example-agent-plugin@example-agent-plugin

# Link plugin into ~/.cursor/plugins/local/example-agent-plugin for local testing
plugin-cursor-upsert: build
    mkdir -p ~/.cursor/plugins/local
    ln -sfn '{{justfile_directory()}}' ~/.cursor/plugins/local/example-agent-plugin
    @echo "Linked MCP plugin to ~/.cursor/plugins/local/example-agent-plugin"

# Run the CLI from source once
run *ARGS:
    bun ./src/index.ts {{ARGS}}

# Install bun/npm dependencies
setup:
    bun install
    test -f node_modules/argsbarg/bin/argsbarg && ln -sf ../argsbarg/bin/argsbarg node_modules/.bin/argsbarg # argsbarg-dev-only: fix link for file:../.. installs

# Run unit tests (after check)
test: check
    bun test .

# Bump version, rebuild the bundle, and publish a release
release *ARGS:
    bun scripts/release.ts {{ARGS}}

# Typecheck without emitting build artifacts
typecheck:
    bun run tsc --noEmit
