set shell := ["bash", "-eu", "-o", "pipefail", "-c"]

export PATH := justfile_directory() + "/node_modules/.bin:" + env_var("PATH")

cli_key := `bun scripts/print-identity.ts key`
tap_org := `bun scripts/print-identity.ts tapOrg`
tap_repo := `bun scripts/print-identity.ts tapRepo`
tap := `bun scripts/print-identity.ts tap`
release_repo := `bun scripts/print-identity.ts releaseRepo`
tap_git_url := "git@github.com:" + release_repo + ".git"
brew_prefix := `brew --prefix`
tap_parent := brew_prefix + "/Library/Taps/" + tap_org
tap_path := tap_parent + "/homebrew-" + tap_repo

# List available recipes (default)
_:
    @just --list

# Compile the CLI binary to dist/full-example
build:
    bun build ./src/index.ts --compile --outfile=dist/{{cli_key}}
    @rm -f .*.bun-build

# Apply SQL migrations in src/db/migrations/ to a SQLite database file
migrate DB="./workspaces.db":
    #!/usr/bin/env bash
    set -euo pipefail
    mkdir -p "$(dirname '{{DB}}')"
    for f in $(ls src/db/migrations/*.sql | sort); do
      echo "==> $f"
      sqlite3 '{{DB}}' < "$f"
    done

# Run schemagen, typecheck, and format
check: schemagen format typecheck

# demo the HTTP API
demo-http:
    #!/usr/bin/env bash
    set -euo pipefail
    bun ./src/index.ts http --port 13000 &
    trap 'kill $! 2>/dev/null || true' EXIT
    until curl -sf http://127.0.0.1:13000/health/liveness >/dev/null; do sleep 0.1; done

# demo a CLI command
demo-cli:
    @just run {{cli_key}} status

# demo a CLI command
demo-help:
    @just run {{cli_key}} --help

# Run the CLI from source with optional args; restarts on file changes
dev *ARGS:
    bun --watch ./src/index.ts {{ARGS}}

# Regenerate consumer docs under ./docs/
docgen: schemagen
    @just run docs cli-schema --save
    @just run docs cli --save
    @just run docs skill --save
    @just run docs mcp --save
    @just run docs http --save
    @just run docs openapi --save

alias fmt := format

# Format and lint sources (auto-fix)
format:
    bun run biome check ./src ./scripts --write --unsafe

# Run the HTTP server
http:
    @just run http

# Alias for backward compatibility
install: install-local

# Refresh skills and MCP without reinstalling the formula
refresh-artifacts:
    just run configure --refresh --yes

# Dev install: build, stage dev formula, brew install, restore release formula
install-local: build
    @NONINTERACTIVE=1 brew untap {{tap}} 2>/dev/null || true
    mkdir -p {{tap_parent}}
    ln -sfn '{{justfile_directory()}}' {{tap_path}}
    bun scripts/dev-formula.ts install
    brew install --force --formula {{tap}}/{{cli_key}}
    bun scripts/dev-formula.ts reset
    @echo ""
    @echo "Next: {{cli_key}} configure"

# Remove local dev install, then install from GitHub tap (requires gh auth login)
install-production: uninstall
    brew tap {{release_repo}} {{tap_git_url}}
    brew install --formula {{release_repo}}/{{cli_key}}
    @echo ""
    @echo "Next: {{cli_key}} configure"

# Alias for backward compatibility
reinstall: reinstall-local

# Rebuild binary and swap into Cellar (run install-local first)
reinstall-local: build
    install -m 755 dist/{{cli_key}} "$(brew --prefix {{cli_key}})/bin/{{cli_key}}"

# Lint sources without writing
lint:
    bun run biome check ./src ./scripts

# Run the CLI from source once
run *ARGS:
    bun ./src/index.ts {{ARGS}}

# Generate JSON Schema artifacts from TypeScript types
schemagen:
    argsbarg schemagen

# Install bun/npm dependencies
# Install bun/npm dependencies and generate schemas
setup:
    bun install
    just schemagen

# Run unit tests (after check)
test: check
    bun test .

# Bump version, build, publish; or pass --purge to delete stale GitHub releases
release *ARGS:
    bun scripts/release.ts {{ARGS}}

# Install release formula from tap and run formula test
test-release:
    NONINTERACTIVE=1 brew untap {{tap}} 2>/dev/null || true
    mkdir -p {{tap_parent}}
    ln -sfn '{{justfile_directory()}}' {{tap_path}}
    NONINTERACTIVE=1 brew uninstall --formula {{tap}}/{{cli_key}} 2>/dev/null || true
    brew install --formula {{tap}}/{{cli_key}}
    brew test {{cli_key}}

# Typecheck without emitting build artifacts
typecheck:
    bun run tsc --noEmit

# Undo just install-local: agent artifacts first, then formula
uninstall: uninstall-artifacts uninstall-formula

# Remove agent artifacts only (skills, MCP)
uninstall-artifacts:
    just run configure --remove-all --yes

# Remove app config file only
uninstall-config:
    just run configure --remove-config --yes

# Remove formula and untap
uninstall-formula:
    @NONINTERACTIVE=1 brew uninstall --formula {{tap}}/{{cli_key}} 2>/dev/null || true
    @NONINTERACTIVE=1 brew uninstall --formula {{tap}}/{{cli_key}}-local 2>/dev/null || true
    @NONINTERACTIVE=1 brew untap {{tap}} 2>/dev/null || true

# Remove release formula (does not untap)
uninstall-release:
    @NONINTERACTIVE=1 brew uninstall --formula {{tap}}/{{cli_key}} 2>/dev/null || true

# Remove release formula and untap
uninstall-release-tap:
    @NONINTERACTIVE=1 brew uninstall --formula {{tap}}/{{cli_key}} 2>/dev/null || true
    @NONINTERACTIVE=1 brew untap {{tap}} 2>/dev/null || true
