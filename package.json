{
  "name": "argsbarg",
  "version": "6.3.2",
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "dependencies": {
    "@cfworker/json-schema": "^4",
    "ts-json-schema-generator": "^2.3.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.5",
    "@types/bun": "^1.3.12",
    "dts-bundle-generator": "^9.5.1",
    "typescript": "^5.9.3"
  },
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./src/index.ts"
    },
    "./cli": {
      "types": "./src/exports/cli.ts",
      "default": "./src/exports/cli.ts"
    },
    "./headless": {
      "types": "./src/exports/headless.ts",
      "default": "./src/exports/headless.ts"
    },
    "./http": {
      "types": "./src/exports/http.ts",
      "default": "./src/exports/http.ts"
    },
    "./mcp": {
      "types": "./src/exports/mcp.ts",
      "default": "./src/exports/mcp.ts"
    },
    "./schemagen": {
      "types": "./src/cli-tool/schemagen/index.ts",
      "default": "./src/cli-tool/schemagen/index.ts"
    }
  },
  "bin": {
    "argsbarg": "bin/argsbarg"
  },
  "engines": {
    "bun": ">=1.3"
  },
  "files": [
    "bin",
    "src",
    "index.d.ts",
    "docs",
    "examples",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "//just": "echo this app uses justfile for development tasks"
  },
  "type": "module",
  "types": "./index.d.ts"
}
